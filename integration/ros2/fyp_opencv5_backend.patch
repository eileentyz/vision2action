@@ -39,4 +39,13 @@ def create_mask_provider(mode='hsv', **options):
         return BasketMaskProvider(debug_callback=options.get('debug_callback'))
     if mode == 'yolo':
+        backend = options.pop('backend', 'ultralytics')
+        socket_path = options.pop('opencv5_socket', '')
+        if backend == 'opencv5':
+            # Same model as ONNX in OpenCV 5 cv2.dnn, served by a separate process (NumPy 2).
+            from galbot_mobile_manipulation.opencv5_mask import OpenCV5MaskProvider
+            return OpenCV5MaskProvider(socket_path=socket_path, **{
+                k: v for k, v in options.items() if k not in ('model_path', 'device')})
+        if backend != 'ultralytics':
+            raise ValueError(f'Unsupported yolo_backend {backend!r}; choose ultralytics or opencv5')
         from galbot_mobile_manipulation.yolo_mask import YoloMaskProvider
         return YoloMaskProvider(**options)
